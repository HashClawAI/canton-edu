---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CantonDocsIndex from '@/components/CantonDocsIndex.astro';
import { t } from '@/i18n/translations';

const locale = 'zh';
const tr = t(locale);
---

<BaseLayout locale={locale} title={tr.docs.title} description={tr.docs.intro} navCurrent="docs">
  <h1 class="page-title">{tr.docs.title}</h1>
  <CantonDocsIndex locale={locale} />
</BaseLayout>
