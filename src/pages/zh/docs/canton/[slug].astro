---
import CantonDocDetail from '@/components/CantonDocDetail.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('canton-doc-pages', ({ data }) => data.locale === 'zh');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<CantonDocDetail locale="zh" entry={entry} />
