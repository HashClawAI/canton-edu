---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCantonDoc, getCantonDocs } from '@/lib/cantonDocs';
import { t } from '@/i18n/translations';

export function getStaticPaths() {
  return getCantonDocs('en').map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const locale = 'en';
const tr = t(locale);
const { doc } = Astro.props;
const base = import.meta.env.BASE_URL;
const zhDoc = getCantonDoc('zh', doc.slug);
---

<BaseLayout locale={locale} title={doc.title} description={doc.summary} navCurrent="docs">
  <p class="breadcrumb"><a href={`${base}docs/canton`}>{tr.docs.title}</a> / {doc.category}</p>
  <h1 class="page-title">{doc.title}</h1>
  <p class="page-intro">{doc.summary}</p>

  <section class="section callout">
    <h2>{tr.docs.verifyAtSource}</h2>
    <p>{tr.docs.detailIntro}</p>
    <ul class="resource-list">
      <li><a href={doc.sourceUrl} target="_blank" rel="noopener noreferrer">{doc.sourceTitle}</a></li>
      <li>{tr.docs.localMarkdown}: <code>{doc.localPath}</code></li>
      {zhDoc && <li><a href={`${base}zh/docs/canton/${zhDoc.slug}`}>中文学习笔记</a></li>}
    </ul>
  </section>

  <section class="section">
    <h2>{tr.docs.tagsTitle}</h2>
    <p class="tag-row">{doc.tags.map((tag) => <span class="tag">{tag}</span>)}</p>
  </section>

  <section class="section">
    <h2>{tr.docs.ragTitle}</h2>
    <p>{tr.docs.ragIntro}</p>
    <ul class="resource-list">
      <li>{tr.docs.localPath}: <code>{doc.localPath}</code></li>
      <li>{tr.docs.ragIndex}: <code>docs/education/canton-dev/rag-index.jsonl</code></li>
    </ul>
  </section>
</BaseLayout>
