---
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import type { Locale } from '@/i18n/translations';
import { t } from '@/i18n/translations';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  navCurrent?: 'home' | 'learn' | 'docs' | 'ecosystem' | 'cips' | 'news' | 'videos' | 'research' | 'community' | 'resources';
}

const { locale, title, description, navCurrent = 'home' } = Astro.props;
const tr = t(locale);
const siteTitle = `${title} · ${tr.siteName}`;
const base = import.meta.env.BASE_URL;
const homeHref = locale === 'zh' ? base : `${base}en/`;
const sectionPrefix = locale === 'zh' ? `${base}zh/` : base;
const ogImagePath = `${base}hashclaw-logo.png`;
const ogImage = new URL(ogImagePath, Astro.site ?? Astro.url.origin);

const footerExplore = [
  { href: homeHref, label: tr.nav.home },
  { href: `${sectionPrefix}learn`, label: tr.nav.learn },
  { href: `${sectionPrefix}docs/canton`, label: tr.nav.docs },
  { href: `${sectionPrefix}ecosystem`, label: tr.nav.ecosystem },
  { href: `${sectionPrefix}cips`, label: tr.nav.cips },
];

const footerContent = [
  { href: `${sectionPrefix}news`, label: tr.nav.news },
  { href: `${sectionPrefix}videos`, label: tr.nav.videos },
  { href: `${sectionPrefix}research`, label: tr.nav.research },
  { href: `${sectionPrefix}community`, label: tr.nav.community },
  { href: `${sectionPrefix}resources`, label: tr.nav.resources },
];

const footerExternal = [
  { href: 'https://github.com/HashClawAI/canton-edu', label: tr.footer.github },
  { href: 'https://www.canton.network/', label: tr.footer.official },
  { href: 'https://docs.canton.network/', label: tr.footer.officialDocs },
];
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-Hans' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={tr.siteKeywords} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <title>{siteTitle}</title>
  </head>
  <body class={`locale-${locale}`}>
    <div class="site-layer">
      <Nav locale={locale} current={navCurrent} />
      <main class="wrap">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="wrap footer-grid">
          <div class="footer-brand">
            <a class="footer-brand-row" href={homeHref}>
              <img class="footer-logo" src={`${base}hashclaw-logo.png`} width="30" height="30" alt="" decoding="async" loading="lazy" />
              <span>{tr.siteName}</span>
            </a>
            <p class="footer-tagline">{tr.footer.tagline}</p>
          </div>
          <nav class="footer-col" aria-label={tr.footer.explore}>
            <h3>{tr.footer.explore}</h3>
            <ul>
              {footerExplore.map(({ href, label }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <nav class="footer-col" aria-label={tr.footer.content}>
            <h3>{tr.footer.content}</h3>
            <ul>
              {footerContent.map(({ href, label }) => (
                <li><a href={href}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <div class="footer-col">
            <h3>{tr.footer.external}</h3>
            <ul>
              {footerExternal.map(({ href, label }) => (
                <li><a href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
              ))}
            </ul>
          </div>
        </div>
        <div class="wrap footer-disclaimer">
          {tr.home.disclaimer}
        </div>
      </footer>
    </div>
  </body>
</html>
