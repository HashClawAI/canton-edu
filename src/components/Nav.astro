---
import type { Locale } from '@/i18n/translations';
import { t } from '@/i18n/translations';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  current?: 'home' | 'learn' | 'docs' | 'ecosystem' | 'cips' | 'news' | 'videos' | 'research' | 'community' | 'resources';
}

const { locale, current = 'home' } = Astro.props;
const tr = t(locale);
const base = import.meta.env.BASE_URL;
const homeHref = locale === 'zh' ? base : `${base}en/`;
const sectionPrefix = locale === 'zh' ? `${base}zh/` : base;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const newsHref = `${sectionPrefix}news`.replace(/\/$/, '');
const isNewsActive = current === 'news' && (pathname === newsHref || pathname.startsWith(`${newsHref}/`));
const docsHref = `${sectionPrefix}docs/canton`.replace(/\/$/, '');
const isDocsActive = current === 'docs' && (pathname === docsHref || pathname.startsWith(`${docsHref}/`));

const navItems = [
  { key: 'home' as const, href: homeHref, label: tr.nav.home },
  { key: 'news' as const, href: `${sectionPrefix}news`, label: tr.nav.news },
  { key: 'learn' as const, href: `${sectionPrefix}learn`, label: tr.nav.learn },
  { key: 'docs' as const, href: `${sectionPrefix}docs/canton`, label: tr.nav.docs },
  { key: 'ecosystem' as const, href: `${sectionPrefix}ecosystem`, label: tr.nav.ecosystem },
  { key: 'cips' as const, href: `${sectionPrefix}cips`, label: tr.nav.cips },
  { key: 'videos' as const, href: `${sectionPrefix}videos`, label: tr.nav.videos },
  { key: 'research' as const, href: `${sectionPrefix}research`, label: tr.nav.research },
  { key: 'community' as const, href: `${sectionPrefix}community`, label: tr.nav.community },
  { key: 'resources' as const, href: `${sectionPrefix}resources`, label: tr.nav.resources },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={homeHref} aria-label={tr.siteName}>
      <img
        class="brand-logo"
        src={`${base}hashclaw-logo.png`}
        width="36"
        height="36"
        alt=""
        decoding="async"
        fetchpriority="high"
      />
      <span class="brand-name">{tr.siteName}</span>
    </a>
    <input type="checkbox" id="nav-menu-toggle" class="nav-toggle-input" aria-hidden="true" />
    <nav class="main-nav" aria-label={tr.lang.label}>
      <div class="main-nav-links">
        {navItems.map(({ key, href, label }) => (
          <a
            href={href}
            aria-current={key === 'news' ? (isNewsActive ? 'page' : undefined) : key === 'docs' ? (isDocsActive ? 'page' : undefined) : current === key ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
      </div>
    </nav>
    <div class="header-actions">
      <LanguageSwitcher locale={locale} />
      <label for="nav-menu-toggle" class="nav-toggle" aria-label="Menu">
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </label>
    </div>
  </div>
</header>
