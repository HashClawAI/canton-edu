---
import type { Locale } from '@/i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;

let path = Astro.url.pathname;
if (path.startsWith(base)) {
  path = path.slice(base.length);
} else {
  path = path.replace(/^\//, '');
}
path = path.replace(/\/$/, '');

/** Chinese home at `/`; English home at `/en/`; other pages mirrored under `/zh/`. */
let otherPath: string;
if (locale === 'zh') {
  if (path === '' || path === 'zh') {
    otherPath = `${base}en/`;
  } else if (path.startsWith('zh/')) {
    otherPath = `${base}${path.slice(3)}`;
  } else {
    otherPath = `${base}en/`;
  }
} else {
  if (path === 'en') {
    otherPath = base;
  } else {
    otherPath = `${base}zh/${path}`;
  }
}

const label = locale === 'en' ? '中文' : 'English';
---

<a class="lang-switch" href={otherPath} hreflang={locale === 'en' ? 'zh' : 'en'}>
  {label}
</a>
