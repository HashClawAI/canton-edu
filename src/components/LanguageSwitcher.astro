---
import type { Locale } from '@/i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;

// Equivalent-path switching: /zh/news <-> /news (every route is mirrored in both locales).
let path = Astro.url.pathname;
if (path.startsWith(base)) {
  path = path.slice(base.length);
} else {
  path = path.replace(/^\//, '');
}
const otherPath = locale === 'en' ? `${base}zh/${path}` : `${base}${path.replace(/^zh\/?/, '')}`;
const label = locale === 'en' ? '中文' : 'English';
---

<a class="lang-switch" href={otherPath} hreflang={locale === 'en' ? 'zh' : 'en'}>
  {label}
</a>
