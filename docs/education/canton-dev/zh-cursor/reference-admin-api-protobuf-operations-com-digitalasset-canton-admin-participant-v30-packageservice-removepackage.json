om.digitalasset.canton.admin.参与方.v30.RemovePackageRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-digitalasset-canton-admin-参与方-v30-removepackagerequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">强制</code>\n                <span class=\"x2mdx-ref-type-badge\">布尔</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.digitalasset.canton.admin.参与方.v30.RemovePackageResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-digitalasset-canton-admin-参与方-v30-removepackageresponse\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">成功</code>\n                <span class=\"x2mdx-ref-type-badge\">空</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>\n\n        ```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.digitalasset.canton.admin.参与方.v30.PackageService/RemovePackage <<'EOF'\n        {\n          \"packageId\": \"string\",\n          \"force\": true\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span>\n\n          <span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>\n\n        ```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {\n          \"success\": \"string\"\n        }\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
