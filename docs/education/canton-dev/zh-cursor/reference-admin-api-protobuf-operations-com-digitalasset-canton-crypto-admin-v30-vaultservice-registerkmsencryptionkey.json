  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>共享管理</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../index\">Protobuf</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../packages/com-digitalasset-canton-crypto-admin-v30\">com.digitalasset.canton.crypto.admin.v30</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>注册KmsEncryptionKey</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.digitalasset.canton.crypto.admin.v30</p>\n\n      <h1 class=\"x2mdx-ref-title\">注册KmsEncryptionKey</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.0 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.digitalasset.canton.crypto.admin.v30.VaultService/RegisterKmsEncryptionKey</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>VaultService</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>注册KmsEncryptionKey</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>否</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=