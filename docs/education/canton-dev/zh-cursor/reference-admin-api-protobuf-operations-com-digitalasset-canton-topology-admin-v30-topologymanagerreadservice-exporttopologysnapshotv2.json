  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>共享管理</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../index\">Protobuf</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../packages/com-digitalasset-canton-topology-admin-v30\">com.digitalasset.canton.topology.admin.v30</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>导出拓扑快照V2</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.digitalasset.canton.topology.admin.v30</p>\n\n      <h1 class=\"x2mdx-ref-title\">导出拓扑快照V2</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.0 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.digitalasset.canton.topology.admin.v30.TopologyManagerReadService/ExportTopologySnapshotV2</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>TopologyManagerReadService</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>导出拓扑快照V2</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>是</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>导出TopologySnapshotV2请求</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.digitalasset.canton.topology.admin.v30.ExportTopologySnapshotV2Request</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">base\\_query</code>\n            <span class=\"x2mdx-ref-type-badge\">基本查询</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">排除\\_mappings</code>\n            <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">过滤器\\_namespace</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>导出TopologySnapshotV2Response</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.digitalasset.canton.topology.admin.v30.ExportTopologySnapshotV2Response</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>是</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref