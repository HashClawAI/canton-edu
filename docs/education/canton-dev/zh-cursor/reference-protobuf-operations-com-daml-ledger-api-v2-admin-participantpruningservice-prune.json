{
  "zhTitle": "Prune",
  "summary": "Admin API Protobuf 操作参考：Prune。",
  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>账本API</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../index\">Protobuf</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../../packages/com-daml-ledger-api-v2-admin\">com.daml.ledger.api.v2.admin</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>修剪</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.daml.ledger.api.v2.admin</p>\n\n      <h1 class=\"x2mdx-ref-title\">修剪</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.0 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.daml.ledger.api.v2.admin.参与方PruningService/Prune</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>参与者修剪服务</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>修剪</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>否</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>修剪请求</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.PruneRequest</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">修剪\\_up\\_to</code>\n            <span class=\"x2mdx-ref-type-badge\">int64</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">提交\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div><div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">修剪\\_all\\_divulged\\_contracts</code>\n            <span class=\"x2mdx-ref-type-badge\">布尔</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>修剪响应</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.PruneResponse</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n    </div>\n\n    ## 生命周期变化\n\n    <div class=\"x2mdx-ref-change-list\">\n      <div class=\"x2mdx-ref-change-item\">\n        <span class=\"x2mdx-ref-change-version\">3.4.0</span>\n        <span class=\"x2mdx-ref-change-detail\">引入</span>\n      </div>\n    </div>\n\n    ## 相关模式\n\n    <手风琴组>\n      <手风琴标题=“com.daml.ledger.api.v2.admin.PruneRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-prunerequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">修剪\\_up\\_to</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">提交\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">修剪\\_all\\_divulged\\_contracts</code>\n                <span class=\"x2mdx-ref-type-badge\">布尔</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.PruneResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-pruneresponse\" />\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.daml.ledger.api.v2.admin.参与方PruningService/Prune <<'EOF'\n        {\n          \"pruneUpTo\": \"0\",\n          \"submissionId\": \"string\",\n          \"pruneAllDivulgedContracts\": true\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span>\n\n          <span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>\n\n        ```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {}\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
}
