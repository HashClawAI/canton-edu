{
  "zhTitle": "GetParties",
  "summary": "Canton 参考文档：GetParties。",
  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>账本API</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../details\">gRPC API</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../com-daml-ledger-api-v2-admin\">v2.admin</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>GetParties</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.daml.ledger.api.v2.admin</p>\n\n      <h1 class=\"x2mdx-ref-title\">GetParties</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.4 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.daml.ledger.api.v2.admin.PartyManagementService/GetParties</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>派对管理服务</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>GetParties</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>否</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>GetPartiesRequest</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.GetPartiesRequest</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">各方</code>\n            <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>GetPartiesResponse</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.GetPartiesResponse</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">派对\\_details</code>\n            <span class=\"x2mdx-ref-type-badge\">重复的派对详细信息</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 生命周期变化\n\n    <div class=\"x2mdx-ref-change-list\">\n      <div class=\"x2mdx-ref-change-item\">\n        <span class=\"x2mdx-ref-change-version\">3.4.4</span>\n        <span class=\"x2mdx-ref-change-detail\">引入</span>\n      </div>\n    </div>\n\n    ## 相关模式\n\n    <手风琴组>\n      <手风琴标题=“com.daml.ledger.api.v2.admin.GetPartiesRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-getpartiesrequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">各方</code>\n                <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n              </div>\n            </div><div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.GetPartiesResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-getpartiesresponse\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">派对\\_details</code>\n                <span class=\"x2mdx-ref-type-badge\">重复的派对详细信息</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.PartyDetails”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-partydetails\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">派对</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">是\\_local</code>\n                <span class=\"x2mdx-ref-type-badge\">布尔</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">本地\\_元数据</code>\n                <span class=\"x2mdx-ref-type-badge\">ObjectMeta</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.ObjectMeta”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-objectmeta\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">资源\\_版本</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">注释</code>\n                <span class=\"x2mdx-ref-type-badge\">重复地图</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>\n\n        ```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.daml.ledger.api.v2.admin.PartyManagementService/GetParties <<'EOF'\n        {\n          \"parties\": [\n            \"string\"\n          ],\n          \"identityProviderId\": \"string\"\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span>\n\n          <span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {\n          \"partyDetails\": [\n            {\n              \"party\": \"string\",\n              \"isLocal\": true,\n              \"localMetadata\": {\n                \"resourceVersion\": \"string\",\n                \"annotations\": [\n                  {\n                    \"key\": \"string\"\n                  }\n                ]\n              },\n              \"identityProviderId\": \"string\"\n            }\n          ]\n        }\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
}
