{
  "zhTitle": "RevokeUserRights",
  "summary": "Canton 参考文档：RevokeUserRights。",
  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>账本API</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../details\">gRPC API</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../com-daml-ledger-api-v2-admin\">v2.admin</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>撤销用户权限</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.daml.ledger.api.v2.admin</p>\n\n      <h1 class=\"x2mdx-ref-title\">撤销用户权限</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.4 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.daml.ledger.api.v2.admin.UserManagementService/RevokeUserRights</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>用户管理服务</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>撤销用户权限</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>否</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>撤销用户权限请求</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.RevokeUserRightsRequest</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">用户\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div><div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">权利</code>\n            <span class=\"x2mdx-ref-type-badge\">重复右</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>撤销用户权限响应</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.admin.RevokeUserRightsResponse</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">新\\_撤销\\_权利</code>\n            <span class=\"x2mdx-ref-type-badge\">重复右</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 生命周期变化\n\n    <div class=\"x2mdx-ref-change-list\">\n      <div class=\"x2mdx-ref-change-item\">\n        <span class=\"x2mdx-ref-change-version\">3.4.4</span>\n        <span class=\"x2mdx-ref-change-detail\">引入</span>\n      </div>\n    </div>\n\n    ## 相关模式\n\n    <手风琴组>\n      <手风琴标题=“com.daml.ledger.api.v2.admin.RevokeUserRightsRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-revokeuserrightsrequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">用户\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">权利</code>\n                <span class=\"x2mdx-ref-type-badge\">重复右</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴><手风琴标题=“com.daml.ledger.api.v2.admin.Right”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">参与者\\_admin</code>\n                <span class=\"x2mdx-ref-type-badge\">参与者管理员</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">可以\\_act\\_as</code>\n                <span class=\"x2mdx-ref-type-badge\">CanActAs</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">可以\\_read\\_as</code>\n                <span class=\"x2mdx-ref-type-badge\">CanReadAs</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">身份\\_provider\\_admin</code>\n                <span class=\"x2mdx-ref-type-badge\">IdentityProviderAdmin</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">可以\\_read\\_as\\_any\\_party</code>\n                <span class=\"x2mdx-ref-type-badge\">CanReadAsAnyParty</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">可以\\_执行\\_as</code>\n                <span class=\"x2mdx-ref-type-badge\">CanExecuteAs</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">可以\\_执行\\_as\\_any\\_party</code>\n                <span class=\"x2mdx-ref-type-badge\">CanExecuteAsAnyParty</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.参与方Admin”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-参与方admin\" />\n      </手风琴><手风琴标题=“com.daml.ledger.api.v2.admin.Right.CanActAs”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-canactas\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">派对</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.CanReadAs”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-canreadas\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">派对</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.CanExecuteAs”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-canexecuteas\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">派对</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.IdentityProviderAdmin”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-identityprovideradmin\" />\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.CanReadAsAnyParty”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-canreadasanyparty\" />\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.admin.Right.CanExecuteAsAnyParty”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-right-canexecuteasanyparty\" />\n      </手风琴><手风琴标题=“com.daml.ledger.api.v2.admin.RevokeUserRightsResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-admin-revokeuserrightsresponse\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">新\\_撤销\\_权利</code>\n                <span class=\"x2mdx-ref-type-badge\">重复右</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>\n\n        ```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.daml.ledger.api.v2.admin.UserManagementService/RevokeUserRights <<'EOF'\n        {\n          \"userId\": \"string\",\n          \"rights\": [\n            {\n              \"参与方Admin\": {}\n            }\n          ],\n          \"identityProviderId\": \"string\"\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span>\n\n          <span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>\n\n        ```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {\n          \"newlyRevokedRights\": [\n            {\n              \"参与方Admin\": {}\n            }\n          ]\n        }\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
}
