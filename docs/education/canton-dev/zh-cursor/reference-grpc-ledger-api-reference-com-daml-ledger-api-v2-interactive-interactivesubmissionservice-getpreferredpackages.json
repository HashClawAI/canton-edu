{
  "zhTitle": "GetPreferredPackages",
  "summary": "Canton 参考文档：GetPreferredPackages。",
  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>账本API</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../details\">gRPC API</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../com-daml-ledger-api-v2-interactive\">v2.interactive</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>获取首选套餐</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.daml.ledger.api.v2.interactive</p>\n\n      <h1 class=\"x2mdx-ref-title\">获取首选包</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.4 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.daml.ledger.api.v2.interactive.InteractiveSubmissionService/GetPreferredPackages</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>交互式提交服务</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>获取首选包</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>否</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>获取首选包请求</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.interactive.GetPreferredPackagesRequest</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">package\\_vetting\\_requirements</code>\n            <span class=\"x2mdx-ref-type-badge\">重复 PackageVettingRequirement</span>\n          </div>\n        </div><div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">同步器\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">审核\\_valid\\_at</code>\n            <span class=\"x2mdx-ref-type-badge\">时间戳</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>获取首选包响应</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.interactive.GetPreferredPackagesResponse</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">包\\_引用</code>\n            <span class=\"x2mdx-ref-type-badge\">重复的PackageReference</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">同步器\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 生命周期变化\n\n    <div class=\"x2mdx-ref-change-list\">\n      <div class=\"x2mdx-ref-change-item\">\n        <span class=\"x2mdx-ref-change-version\">3.4.4</span>\n        <span class=\"x2mdx-ref-change-detail\">引入</span>\n      </div>\n    </div>\n\n    ## 相关模式\n\n    <手风琴组>\n      <手风琴标题=“com.daml.ledger.api.v2.interactive.GetPreferredPackagesRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-interactive-getpreferredpackagesrequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">package\\_vetting\\_requirements</code>\n                <span class=\"x2mdx-ref-type-badge\">重复 PackageVettingRequirement</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">同步器\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div><div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">审核\\_valid\\_at</code>\n                <span class=\"x2mdx-ref-type-badge\">时间戳</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.interactive.PackageVettingRequirement”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-interactive-packagevettingrequirement\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">各方</code>\n                <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_name</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.interactive.GetPreferredPackagesResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-interactive-getpreferredpackagesresponse\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_引用</code>\n                <span class=\"x2mdx-ref-type-badge\">重复的PackageReference</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">同步器\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.PackageReference”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-packagereference\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_name</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div><div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">包\\_版本</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>\n\n        ```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.daml.ledger.api.v2.interactive.InteractiveSubmissionService/GetPreferredPackages <<'EOF'\n        {\n          \"packageVettingRequirements\": [\n            {\n              \"parties\": [\n                \"string\"\n              ],\n              \"packageName\": \"string\"\n            }\n          ],\n          \"同步器Id\": \"string\",\n          \"vettingValidAt\": \"string\"\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span>\n\n          <span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>\n\n        ```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {\n          \"packageReferences\": [\n            {\n              \"packageId\": \"string\",\n              \"packageName\": \"string\",\n              \"packageVersion\": \"string\"\n            }\n          ],\n          \"同步器Id\": \"string\"\n        }\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
}
