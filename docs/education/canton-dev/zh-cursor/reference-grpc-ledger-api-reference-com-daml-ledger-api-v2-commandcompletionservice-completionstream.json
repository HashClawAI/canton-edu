{
  "zhTitle": "CompletionStream",
  "summary": "Canton 参考文档：CompletionStream。",
  "body": "<div class=\"x2mdx-ref-page x2mdx-ref-page--操作\" />\n\n<div className=\"x2mdx-ref-operation-shell\">\n  <div className=\"x2mdx-ref-operation-main\">\n    <div class=\"x2mdx-ref-breadcrumbs\" role=\"navigation\" aria-label=\"Breadcrumb\">\n      <span>账本API</span>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../details\">gRPC API</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <a href=\"../../com-daml-ledger-api-v2\">v2</a>\n\n      <span class=\"x2mdx-ref-breadcrumb-separator\">›</span>\n\n      <span>完成流</span>\n    </div>\n\n    <div class=\"x2mdx-ref-hero\">\n      <p class=\"x2mdx-ref-eyebrow\">com.daml.ledger.api.v2</p>\n\n      <h1 class=\"x2mdx-ref-title\">CompletionStream</h1>\n\n      <div class=\"x2mdx-ref-badges\">\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--protocol\">gRPC</span>\n\n        <span class=\"x2mdx-ref-badge x2mdx-ref-badge--linked\">自 3.4.4 起</span>\n      </div>\n    </div>\n\n    <div class=\"x2mdx-ref-operation-bar\">\n      <span class=\"x2mdx-ref-operation-method x2mdx-ref-operation-method--rpc\">RPC</span>\n\n      <code>/com.daml.ledger.api.v2.CommandCompletionService/CompletionStream</code>\n    </div>\n\n    ## 协议详细信息\n\n    <dl class=\"x2mdx-ref-meta-grid\">\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>协议</dt>\n        <dd>gRPC</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务</dt>\n        <dd>命令完成服务</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>RPC</dt>\n        <dd>完成流</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>客户端流</dt>\n        <dd>否</dd>\n      </div>\n\n      <div class=\"x2mdx-ref-meta-item\">\n        <dt>服务器流</dt>\n        <dd>是</dd>\n      </div>\n    </dl>\n\n    ## 输入\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>CompletionStreamRequest</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.CompletionStreamRequest</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>客户端流</dt>\n          <dd>否</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">用户\\_id</code>\n            <span class=\"x2mdx-ref-type-badge\">字符串</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">各方</code>\n            <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n          </div>\n        </div><div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">开始\\_exclusive</code>\n            <span class=\"x2mdx-ref-type-badge\">int64</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 输出\n\n    <div class=\"x2mdx-ref-panel\">\n      <div class=\"x2mdx-ref-panel-head\">\n        <h3>CompletionStreamResponse</h3>\n      </div>\n\n      <dl class=\"x2mdx-ref-meta-grid\">\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>消息</dt>\n          <dd>com.daml.ledger.api.v2.CompletionStreamResponse</dd>\n        </div>\n\n        <div class=\"x2mdx-ref-meta-item\">\n          <dt>服务器流</dt>\n          <dd>是</dd>\n        </div>\n      </dl>\n\n      <div class=\"x2mdx-ref-fields\">\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">完成</code>\n            <span class=\"x2mdx-ref-type-badge\">完成</span>\n          </div>\n        </div>\n\n        <div class=\"x2mdx-ref-field-row\">\n          <div class=\"x2mdx-ref-field-main\">\n            <code class=\"x2mdx-ref-field-name\">偏移量\\_checkpoint</code>\n            <span class=\"x2mdx-ref-type-badge\">OffsetCheckpoint</span>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    ## 生命周期变化\n\n    <div class=\"x2mdx-ref-change-list\">\n      <div class=\"x2mdx-ref-change-item\">\n        <span class=\"x2mdx-ref-change-version\">3.4.4</span>\n        <span class=\"x2mdx-ref-change-detail\">引入</span>\n      </div>\n    </div>\n\n    ## 相关模式\n\n    <手风琴组>\n      <手风琴标题=“com.daml.ledger.api.v2.CompletionStreamRequest”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-completionstreamrequest\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">用户\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">各方</code>\n                <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">开始\\_exclusive</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴><手风琴标题=“com.daml.ledger.api.v2.CompletionStreamResponse”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-completionstreamresponse\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">完成</code>\n                <span class=\"x2mdx-ref-type-badge\">完成</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">偏移量\\_checkpoint</code>\n                <span class=\"x2mdx-ref-type-badge\">OffsetCheckpoint</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.Completion”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-completion\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">命令\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">状态</code>\n                <span class=\"x2mdx-ref-type-badge\">状态</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">更新\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">用户\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">act\\_as</code>\n                <span class=\"x2mdx-ref-type-badge\">重复字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">提交\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div><div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">重复数据删除\\_offset</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">重复数据删除\\_duration</code>\n                <span class=\"x2mdx-ref-type-badge\">持续时间</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">trace\\_context</code>\n                <span class=\"x2mdx-ref-type-badge\">TraceContext</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">偏移量</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">同步器\\_time</code>\n                <span class=\"x2mdx-ref-type-badge\">同步器时间</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">付费\\_traffic\\_cost</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.TraceContext”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-tracecontext\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">traceparent</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">跟踪状态</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴><手风琴标题=“com.daml.ledger.api.v2.同步器Time”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-同步器time\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">同步器\\_id</code>\n                <span class=\"x2mdx-ref-type-badge\">字符串</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">记录\\_时间</code>\n                <span class=\"x2mdx-ref-type-badge\">时间戳</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n\n      <手风琴标题=“com.daml.ledger.api.v2.OffsetCheckpoint”>\n        <div class=\"x2mdx-ref-schema\" id=\"schema-com-daml-ledger-api-v2-offsetcheckpoint\">\n          <div class=\"x2mdx-ref-fields\">\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">偏移量</code>\n                <span class=\"x2mdx-ref-type-badge\">int64</span>\n              </div>\n            </div>\n\n            <div class=\"x2mdx-ref-field-row\">\n              <div class=\"x2mdx-ref-field-main\">\n                <code class=\"x2mdx-ref-field-name\">同步器\\_times</code>\n                <span class=\"x2mdx-ref-type-badge\">重复同步器时间</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </手风琴>\n    </手风琴组>\n  </div>\n\n  <div className=\"x2mdx-ref-right-rail\" role=\"complementary\" aria-label=\"示例和响应\">\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">grpcurl</span>\n        </div>\n\n        ```bash grpcurl theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        # Add -plaintext if the server is not using TLS.\n        # This RPC uses streaming semantics. Send additional JSON messages on stdin as needed.\n        grpcurl \\\n          -d @ \\\n          <HOST:PORT> \\\n          com.daml.ledger.api.v2.CommandCompletionService/CompletionStream <<'EOF'\n        {\n          \"userId\": \"string\",\n          \"parties\": [\n            \"string\"\n          ],\n          \"beginExclusive\": \"0\"\n        }\n        EOF\n        ```\n      </div>\n    </div>\n\n    <div className=\"x2mdx-ref-rail-panel\">\n      <div className=\"x2mdx-ref-rail-code x2mdx-ref-rail-code--response\">\n        <div className=\"x2mdx-ref-rail-head\">\n          <span className=\"x2mdx-ref-rail-heading\">确定</span><span className=\"x2mdx-ref-response-label\">application/json</span>\n        </div>\n\n        ```json OK theme={\"theme\":{\"light\":\"github-light\",\"dark\":\"github-dark\"}}\n        {\n          \"completion\": {\n            \"commandId\": \"string\",\n            \"status\": \"string\",\n            \"updateId\": \"string\",\n            \"userId\": \"string\",\n            \"actAs\": [\n              \"string\"\n            ],\n            \"submissionId\": \"string\",\n            \"deduplicationOffset\": \"0\"\n          }\n        }\n        ```\n      </div>\n    </div>\n  </div>\n</div>"
}
